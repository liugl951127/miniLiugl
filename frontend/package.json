{
  "name": "minimax-web",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "browserslist": [
    "Chrome >= 63",
    "Edge >= 79",
    "Firefox >= 60",
    "Safari >= 12",
    "Opera >= 50",
    "iOS >= 12",
    "Android >= 8",
    "not dead",
    "not IE 11"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173",
    "lint": "eslint . --ext .vue,.js,.jsx,.ts,.tsx --fix",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest --watch",
    "test:unit:ui": "vitest --ui",
    "test:unit:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "cap:sync": "cap sync",
    "cap:open:ios": "cap open ios",
    "cap:open:android": "cap open android",
    "cap:add:ios": "cap add ios",
    "cap:add:android": "cap add android",
    "cap:copy": "cap copy",
    "cap:build:ios": "cap copy ios && cap open ios",
    "cap:build:android": "cap copy android && cap open android"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "@intlify/unplugin-vue-i18n": "^1.4.0",
    "@vueuse/core": "^8.9.0",
    "axios": "^1.6.7",
    "dayjs": "^1.11.10",
    "echarts": "^5.5.0",
    "element-plus": "^2.4.4",
    "highlight.js": "^11.9.0",
    "markdown-it": "^14.1.0",
    "pinia": "^2.1.7",
    "pinia-plugin-persistedstate": "^3.2.1",
    "qrcode": "^1.5.4",
    "tesseract.js": "^5.1.1",
    "vant": "^4.9.24",
    "vite-plugin-cdn-import": "^1.0.1",
    "vue": "^3.3.13",
    "vue-echarts": "^7.0.3",
    "vue-i18n": "^9.8.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@capacitor/android": "^6.2.1",
    "@capacitor/app": "^6.0.3",
    "@capacitor/cli": "^6.2.1",
    "@capacitor/core": "^6.2.1",
    "@capacitor/haptics": "^6.0.3",
    "@capacitor/ios": "^6.2.1",
    "@capacitor/keyboard": "^6.0.4",
    "@capacitor/network": "^6.0.4",
    "@capacitor/preferences": "^6.0.4",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@eslint/js": "^8.57.1",
    "@playwright/test": "^1.61.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-vue": "^4.6.2",
    "@vitest/coverage-v8": "^0.34.4",
    "@vitest/ui": "^4.1.9",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^22.1.0",
    "sass": "^1.71.1",
    "terser": "^5.49.0",
    "typescript": "^5.3.3",
    "unplugin-auto-import": "^0.16.7",
    "unplugin-vue-components": "^0.25.2",
    "vite": "^4.5.2",
    "vitest": "^0.34.6",
    "vue-eslint-parser": "^9.4.3"
  },
  "engines": {
    "node": ">=16.20.0 <17 || >=18.0.0",
    "npm": ">=8.0.0"
  }
}