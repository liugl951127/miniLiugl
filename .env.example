# ============================================================
# MiniMax Platform V6.8.2 — Docker Compose 环境变量示例
#
# 复制此文件为 .env 并填入真实值:
#   cp .env.example .env
#   # 编辑 .env 填入真实凭证
#
# ⚠️ .env 文件已在 .gitignore 中，不会被提交到 Git
# ⚠️ 生产环境必须替换所有示例值为真实凭证
# ============================================================

# ========== 安全凭证 (必填) ==========

# JWT 签名密钥 — 生产必须使用 256-bit (64字符) 随机 hex
# 生成: openssl rand -hex 32
MINIMAX_JWT_SECRET=CHANGE_ME_64_CHARACTER_HEX_STRING

# 通用加密密钥 — 用于通用加密/签名场景
MINIMAX_COMMON_SECRET=CHANGE_ME_64_CHARACTER_HEX_STRING

# Redis 密码
REDIS_PASS=your_redis_password_here

# Nacos 账户
NACOS_USER=nacos
NACOS_PASS=your_nacos_password_here

# MariaDB root 密码
MYSQL_ROOT_PASSWORD=your_mysql_root_password_here

# CORS 允许的跨域域名 (逗号分隔，生产填真实域名)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# ========== 可选配置 ==========

# SMTP 邮件通知 (monitor 模块)
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password_or_app_password

# SiliconFlow API Key (多模态: TTS/ASR/图片生成)
# SILICONFLOW_API_KEY=sk-your-siliconflow-key

# MinIO 对象存储
# MINIO_ACCESS_KEY=your_minio_access_key
# MINIO_SECRET_KEY=your_minio_secret_key
